{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/replacearr/replacearr-plugins/schemas/plugin.schema.json",
  "title": "Replacearr marketplace plugin.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "author",
    "description",
    "types",
    "homepage",
    "repository",
    "minReplacearrVersion",
    "entry",
    "module"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Stable plugin id; installed binary is named after this id."
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9.-]+)?$"
    },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "indexer",
          "download_client",
          "metadata",
          "notification",
          "media_module",
          "network_proxy",
          "compat"
        ]
      }
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "minReplacearrVersion": { "type": "string", "minLength": 1 },
    "entry": {
      "type": "string",
      "description": "Go package path relative to the plugin directory (usually \".\")."
    },
    "module": {
      "type": "string",
      "description": "Go module path for this plugin."
    }
  }
}
